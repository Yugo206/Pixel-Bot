# Copier ce fichier en .env et remplacer les valeurs.
# Voir le README (section "Ajout du .env") pour le détail de chaque variable.

DISCORD_TOKEN=
CHANNEL_MODO_ID=
ROLE_MODO_ID=
GUILD_ID=
CHANNEL_TRADE_ID=
CHANNEL_COMMANDE_ID=
CHANNEL_RECRUTEMENT=
ROLE_RECRUTEMENT=
ROLE_VISITE=
OWNER_ID=

# Base de données MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optionnel — modulable selon l'hébergement (voir README) :
# - DB_SSL : true si l'hébergeur de la base l'exige (ex: alwaysdata), false pour
#   une base locale ou sur le même serveur que le bot (défaut : false).
# - DB_SSL_CA : chemin vers un certificat CA custom, rarement nécessaire.
# - DB_POOL_RECYCLE : secondes avant recyclage des connexions inactives du pool,
#   évite les "MySQL server has gone away" sur de l'hébergement mutualisé
#   (défaut : 1800).
DB_SSL=false
# DB_SSL_CA=
DB_POOL_RECYCLE=1800
