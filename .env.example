# Copier ce fichier en .env et remplacer les valeurs.
# Voir le README (section "Ajout du .env") pour le détail de chaque variable.

DISCORD_TOKEN=

# Base de données MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optionnel — modulable selon l'hébergement (voir README) :
# - DB_SSL : true si l'hébergeur de la base l'exige (ex: alwaysdata), false pour
#   une base locale ou sur le même serveur que le bot (défaut : false).
# - DB_SSL_CA : chemin vers un certificat CA custom, rarement nécessaire.
# - DB_POOL_RECYCLE : secondes avant recyclage des connexions inactives du pool,
#   évite les "MySQL server has gone away" sur de l'hébergement mutualisé
#   (défaut : 1800).
# - DB_POOL_MINSIZE / DB_POOL_MAXSIZE : nombre de connexions min/max gardées
#   ouvertes dans le pool. À augmenter sur un hébergement avec plus de marge
#   (ex: VPS dédié) ; à réduire si le quota de connexions/RAM est serré
#   (défauts : 1 / 5).
DB_SSL=false
# DB_SSL_CA=
DB_POOL_RECYCLE=1800
DB_POOL_MINSIZE=1
DB_POOL_MAXSIZE=5

# LOG_LEVEL : niveau de verbosité des logs (DEBUG/INFO/WARNING/ERROR), défaut INFO.
LOG_LEVEL=INFO

# Tous les autres réglages (IDs de rôles/salons, OWNER_ID, DM_ERROR_COOLDOWN,
# DAILY_REWARD/DAILY_COOLDOWN...) sont désormais stockés en base, dans la table
# `config`, et non dans ce fichier — voir README (section "Réglages en base").
# Ils s'éditent directement en base (comme la table `shop`), sans redémarrage.
#
# Cas particulier : au tout premier démarrage sur une base neuve, une migration
# automatique (_migrate_env_to_config, voir utils/setupdatabase.py) copie ces
# variables vers `config` si elles sont présentes ici — pratique pour pré-remplir
# une nouvelle installation sans passer par du SQL manuel. Une fois cette première
# migration faite, les variables ci-dessous peuvent être retirées de .env sans
# aucun effet : elles ne sont plus jamais relues après ce premier démarrage.
#
# GUILD_ID=
# OWNER_ID=
# CHANNEL_COMMANDE_ID=
# CHANNEL_MODO_ID=
# CHANNEL_TRADE_ID=
# ROLE_MODO_ID=
# ROLE_RECRUTEMENT=
# ROLE_PC=
# ROLE_XBOX=
# ROLE_PLAYSTATION=
# ROLE_NINTENDO=
# ROLE_FORTNITE=
# ROLE_MINECRAFT=
# ROLE_BRAWLSTARS=
# ROLE_GTA=
# ROLE_ROBLOX=
# DM_ERROR_COOLDOWN=300
# DAILY_REWARD=50
# DAILY_COOLDOWN=86400
